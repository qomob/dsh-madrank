{
  "name": "@qomob/dsh-madrank",
  "version": "0.4.0",
  "description": "MADRank Usage — track your AI usage in DeepSeek Harness, see how you rank.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qomob/dsh-madrank.git"
  },
  "homepage": "https://madrank.ai",
  "bugs": "https://github.com/qomob/dsh-madrank/issues",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "madrank",
    "usage",
    "plugin",
    "tokens"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "build:host": "tsc -p tsconfig.build.json",
    "build": "npm run build:host && npm run build:client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reconcile": "node --experimental-strip-types tools/reconcile-cli.ts",
    "preview": "node --experimental-strip-types tools/build-card-preview.ts",
    "reconcile:fixture": "node --experimental-strip-types tools/reconcile-cli.ts tests/fixtures/real-world/usage-events.jsonl",
    "verify:dsh": "node --experimental-strip-types tools/verify-compat.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "happy-dom": "^20.12.0",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
