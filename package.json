{
  "name": "@qomob/dsh-madrank",
  "version": "0.2.0",
  "description": "MADRank Usage — track your AI usage in DeepSeek Harness, see how you rank.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qomob/dsh-madrank.git"
  },
  "homepage": "https://madrank.ai",
  "bugs": "https://github.com/qomob/dsh-madrank/issues",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "madrank",
    "usage",
    "plugin",
    "tokens"
  ],
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reconcile": "node --experimental-strip-types tools/reconcile-cli.ts",
    "preview": "node --experimental-strip-types tools/build-card-preview.ts",
    "reconcile:fixture": "node --experimental-strip-types tools/reconcile-cli.ts tests/fixtures/real-world/usage-events.jsonl",
    "verify:dsh": "node --experimental-strip-types tools/verify-compat.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "_note": "浏览器半侧经 DSH 客户端模块系统打包后启用；见 README 集成章节"
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "happy-dom": "^20.12.0",
    "react-dom": "^19.2.8"
  }
}
